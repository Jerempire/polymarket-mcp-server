# Market Eagle Eye MCP Server

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Legacy sentiment cache setting
SENTIMENT_CACHE_TTL_SECONDS=300

# Polymarket API migration layer
POLYMARKET_PRIMARY_API_URL=https://gamma-api.polymarket.com
POLYMARKET_FALLBACK_API_URL=https://gamma-api.polymarket.com
POLYMARKET_MARKETS_PATHS=/markets,/v1/markets

# Polygon adapter
POLYGON_API_URL=https://api.massive.com
POLYGON_API_KEY=
# Optional comma-separated allowlist, e.g. AAPL,MSFT,NVDA
POLYGON_TICKERS=

# Squawk feed adapter (set URL or local file)
SQUAWK_FEED_URL=https://api.massive.com/benzinga/v2/news
SQUAWK_FEED_FILE=
# If blank, adapter falls back to POLYGON_API_KEY
SQUAWK_API_KEY=

# Eagle Eye defaults
EAGLE_EYE_ENABLE_POLYMARKET=true
EAGLE_EYE_ENABLE_POLYGON=true
EAGLE_EYE_ENABLE_SQUAWK=true
EAGLE_EYE_WINDOW_MINUTES=240
EAGLE_EYE_TOP_NARRATIVES=12
EAGLE_EYE_SOURCE_LIMIT=60
EAGLE_EYE_CACHE_TTL_SECONDS=20

# Dashboard API settings
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8070
